# Application
APP_NAME=Enterprise AI OS
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-very-long-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8060

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/enterprise_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0
# true = create missing tables at startup (local development only).
# Deployed environments use false; the container runs `alembic upgrade head` before starting.
DATABASE_AUTO_CREATE=true

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_MICROSOFT_CLIENT_ID=
OAUTH2_MICROSOFT_CLIENT_SECRET=

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
# Leave empty to reuse OLLAMA_MODEL for embeddings
OLLAMA_EMBEDDING_MODEL=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_STREAM_TIMEOUT_SECONDS=300
OLLAMA_EMBED_TIMEOUT_SECONDS=60

# Default AI Provider (openai | azure_openai | gemini | anthropic | ollama)
AI_PROVIDER=openai

# Embeddings
# Leave EMBEDDING_PROVIDER empty to use AI_PROVIDER. Changing the embedding provider,
# model, or dimension requires re-ingesting all documents.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# RAG tuning
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
# Upper bound per chunk, for scripts written without spaces between words
RAG_CHUNK_MAX_CHARS=5000
RAG_TOP_K=5
RAG_TEMPERATURE=0.3
# 0 = rank by vector similarity only (works across languages); 1 = keyword overlap only
RAG_RERANK_LEXICAL_WEIGHT=0.3
# Default reranker for tenants without their own choice (admins can override per tenant):
# vector = similarity score only; llm = the chat model ranks passages by meaning in any
# language it supports (adds one LLM call per question)
RAG_RERANKER=vector
RAG_RERANK_MAX_PASSAGE_CHARS=1500
# Rewrite follow-up questions into standalone questions using earlier messages
RAG_QUERY_REWRITE=true
RAG_REWRITE_HISTORY_TURNS=6

# LLM call resilience (all providers): timeout per call, retries for temporary failures
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY_SECONDS=1.0

# Multilingual: detect the question's language and translate it to English for retrieval.
# Adds one LLM call per non-English question. Answers are written in the user's language.
MULTILINGUAL_QUERY_ANALYSIS=true
# Languages offered in the UI (ISO codes)
SUPPORTED_LANGUAGES=en,am,om

# Vector Store (pgvector | qdrant)
VECTOR_STORE=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=enterprise_ai

# Messaging (kafka | rabbitmq | azure_service_bus)
MESSAGING_BACKEND=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AZURE_SERVICE_BUS_CONNECTION_STRING=

# Object Storage (s3 | azure_blob | gcs)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=enterprise-ai-documents

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# Google Cloud Storage — used when STORAGE_BACKEND=gcs
# GCS_PROJECT_ID and GCS_BUCKET are set automatically by Cloud Build on GCP.
# For local dev, fill these in and optionally paste a service-account JSON key.
GCS_PROJECT_ID=main-presence-500410-f8
GCS_BUCKET=enterprise-ai-documents
# Paste the full JSON key string (single line) for local dev.
# Leave EMPTY on Cloud Run — Application Default Credentials are injected automatically.
GCS_CREDENTIALS_JSON=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-ai-os
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Multi-Tenancy
DEFAULT_TENANT_ID=default
TENANT_ISOLATION_STRATEGY=shared_schema

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@enterprise-ai.com

# Cors
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
