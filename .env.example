# Application
APP_NAME=Enterprise AI OS
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-very-long-random-secret-key
APP_HOST=0.0.0.0
APP_PORT=8060

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/enterprise_ai
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OAuth2
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_MICROSOFT_CLIENT_ID=
OAUTH2_MICROSOFT_CLIENT_SECRET=

# AI Providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

GEMINI_API_KEY=
ANTHROPIC_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Default AI Provider (openai | azure_openai | gemini | anthropic | ollama)
AI_PROVIDER=openai

# Embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Vector Store (pgvector | qdrant)
VECTOR_STORE=pgvector
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=enterprise_ai

# Messaging (kafka | rabbitmq | azure_service_bus)
MESSAGING_BACKEND=kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AZURE_SERVICE_BUS_CONNECTION_STRING=

# Object Storage (s3 | azure_blob | gcs)
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=enterprise-ai-documents

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=documents

# Google Cloud Storage — used when STORAGE_BACKEND=gcs
# GCS_PROJECT_ID and GCS_BUCKET are set automatically by Cloud Build on GCP.
# For local dev, fill these in and optionally paste a service-account JSON key.
GCS_PROJECT_ID=main-presence-500410-f8
GCS_BUCKET=enterprise-ai-documents
# Paste the full JSON key string (single line) for local dev.
# Leave EMPTY on Cloud Run — Application Default Credentials are injected automatically.
GCS_CREDENTIALS_JSON=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-ai-os
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json

# Multi-Tenancy
DEFAULT_TENANT_ID=default
TENANT_ISOLATION_STRATEGY=shared_schema

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@enterprise-ai.com

# Cors
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
